{
  "description": "Load repository-owned Agent Kit context, flag meeting recordings waiting for transcription, and run the Airtable automations. Every hook is a fast no-op unless .nemeda/agent-kit.json configures the matching section.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-context.mjs\"",
            "timeout": 10,
            "statusMessage": "Loading repository context"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/meeting-inbox.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking for meeting recordings to transcribe"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pr-airtable-reconcile.mjs\"",
            "timeout": 30,
            "statusMessage": "Syncing open/merged PR status with Airtable"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pr-airtable-sync.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-log.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
