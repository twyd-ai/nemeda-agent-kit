{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nemeda:agent-kit:schema:v1",
  "title": "Nemeda Agent Kit repository configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "context", "tools", "policies"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories"],
      "properties": {
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workspaceRepository"
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions"],
      "properties": {
        "instructions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["AGENTS.md"]
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protectSecrets"],
      "properties": {
        "protectSecrets": {
          "type": "boolean"
        },
        "conversationLanguage": {
          "type": "string"
        },
        "artifactLanguage": {
          "type": "string"
        }
      }
    },
    "drive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sharedDrive", "links"],
      "properties": {
        "sharedDrive": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the Google shared drive that holds docs, config, skills, and commands."
        },
        "links": {
          "type": "object",
          "minProperties": 1,
          "description": "Map of workspace-relative symlink paths to shared-drive-relative folders.",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "airtable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseId"],
      "properties": {
        "baseId": {
          "type": "string",
          "pattern": "^app[a-zA-Z0-9]{14}$"
        },
        "tasks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tableId", "statusField", "notesField", "statusInProgress", "statusDone"],
          "properties": {
            "tableId": {
              "type": "string",
              "pattern": "^tbl[a-zA-Z0-9]{14}$"
            },
            "statusField": {
              "type": "string",
              "minLength": 1
            },
            "notesField": {
              "type": "string",
              "minLength": 1
            },
            "statusInProgress": {
              "type": "string",
              "minLength": 1
            },
            "statusDone": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "knowledgeLog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tableId"],
          "properties": {
            "baseId": {
              "type": "string",
              "pattern": "^app[a-zA-Z0-9]{14}$",
              "description": "Optional override when the Knowledge Log lives in a different base."
            },
            "tableId": {
              "type": "string",
              "pattern": "^tbl[a-zA-Z0-9]{14}$"
            },
            "people": {
              "type": "object",
              "description": "Map of git user.email to the person's Airtable record id.",
              "additionalProperties": {
                "type": "string",
                "pattern": "^rec[a-zA-Z0-9]{14}$"
              }
            }
          }
        },
        "reconcileRepos": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\w.-]+/[\\w.-]+$"
          },
          "description": "GitHub owner/repo list scanned for open and merged PRs during reconciliation."
        },
        "lookbackDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        }
      }
    },
    "slack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels", "owner"],
      "description": "Slack bridge routing for this repository. Tokens are never stored here; they live in ~/.nemeda/.env.local.",
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[CGD][A-Z0-9]{6,}$"
          },
          "description": "Slack channel ids routed to this repository."
        },
        "owner": {
          "type": "string",
          "pattern": "^[UW][A-Z0-9]{6,}$",
          "description": "Slack user id this runner belongs to."
        },
        "guests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[UW][A-Z0-9]{6,}$"
          },
          "description": "Extra Slack user ids this runner answers, typically teammates without their own agent plan."
        },
        "backend": {
          "enum": ["claude", "codex"],
          "default": "claude"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Model alias passed to the backend CLI."
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "description": "Git ref answered from, through a detached mirror worktree. Omit to answer from the working tree."
        },
        "maxQuestionsPerHour": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 20
        },
        "maxAnswerChars": {
          "type": "integer",
          "minimum": 200,
          "maximum": 8000,
          "default": 1500
        },
        "followThreads": {
          "type": "boolean",
          "default": true,
          "description": "Answer follow-ups in a thread the runner already replied in, without a new mention."
        },
        "onUnauthorized": {
          "enum": ["silent", "ephemeral"],
          "default": "ephemeral"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 900,
          "default": 240
        }
      }
    }
  },
  "oneOf": [
    {
      "required": ["repository"]
    },
    {
      "required": ["workspace"]
    }
  ],
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "profiles"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workspaceRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "role", "profiles"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remote": {
          "type": "string",
          "minLength": 1,
          "description": "Git URL cloned by `nemeda-agent setup` when the path is missing."
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
