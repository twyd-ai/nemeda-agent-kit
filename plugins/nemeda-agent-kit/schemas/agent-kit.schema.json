{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nemeda:agent-kit:schema:v1",
  "title": "Nemeda Agent Kit repository configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "context", "tools", "policies"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories"],
      "properties": {
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workspaceRepository"
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions"],
      "properties": {
        "instructions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["AGENTS.md"]
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protectSecrets"],
      "properties": {
        "protectSecrets": {
          "type": "boolean"
        },
        "conversationLanguage": {
          "type": "string"
        },
        "artifactLanguage": {
          "type": "string"
        }
      }
    }
  },
  "oneOf": [
    {
      "required": ["repository"]
    },
    {
      "required": ["workspace"]
    }
  ],
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "profiles"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workspaceRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "role", "profiles"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
