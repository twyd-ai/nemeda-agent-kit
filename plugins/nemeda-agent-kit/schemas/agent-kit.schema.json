{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nemeda:agent-kit:schema:v1",
  "title": "Nemeda Agent Kit repository configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "context", "tools", "policies"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories"],
      "properties": {
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workspaceRepository"
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions"],
      "properties": {
        "instructions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["AGENTS.md"]
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protectSecrets"],
      "properties": {
        "protectSecrets": {
          "type": "boolean"
        },
        "conversationLanguage": {
          "type": "string"
        },
        "artifactLanguage": {
          "type": "string"
        }
      }
    },
    "drive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sharedDrive", "links"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["google", "onedrive"],
          "default": "google",
          "description": "Shared-storage provider whose desktop client syncs the shared drive. Defaults to google."
        },
        "sharedDrive": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the shared drive (or synced document library) that holds docs, config, skills, and commands."
        },
        "links": {
          "type": "object",
          "minProperties": 1,
          "description": "Map of workspace-relative symlink paths to shared-drive-relative folders.",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "scaffold": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Shared-drive-relative folders that `nemeda-agent setup` creates when missing (e.g. the docs taxonomy: docs/meets, docs/transcriptions). Keeps every project's Drive structure consistent."
        }
      }
    },
    "airtable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseId"],
      "properties": {
        "baseId": {
          "type": "string",
          "pattern": "^app[a-zA-Z0-9]{14}$"
        },
        "tasks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tableId", "statusField", "notesField", "statusInProgress", "statusDone"],
          "properties": {
            "tableId": {
              "type": "string",
              "pattern": "^tbl[a-zA-Z0-9]{14}$"
            },
            "statusField": {
              "type": "string",
              "minLength": 1
            },
            "notesField": {
              "type": "string",
              "minLength": 1
            },
            "statusInProgress": {
              "type": "string",
              "minLength": 1
            },
            "statusDone": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "knowledgeLog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tableId"],
          "properties": {
            "baseId": {
              "type": "string",
              "pattern": "^app[a-zA-Z0-9]{14}$",
              "description": "Optional override when the Knowledge Log lives in a different base."
            },
            "tableId": {
              "type": "string",
              "pattern": "^tbl[a-zA-Z0-9]{14}$"
            },
            "people": {
              "type": "object",
              "description": "Map of git user.email to the person's Airtable record id.",
              "additionalProperties": {
                "type": "string",
                "pattern": "^rec[a-zA-Z0-9]{14}$"
              }
            }
          }
        },
        "reconcileRepos": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\w.-]+/[\\w.-]+$"
          },
          "description": "GitHub owner/repo list scanned for open and merged PRs during reconciliation."
        },
        "lookbackDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        }
      }
    },
    "slack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels", "owner"],
      "description": "Slack bridge routing for this repository. Tokens are never stored here; they live in ~/.nemeda/.env.local.",
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[CGD][A-Z0-9]{6,}$"
          },
          "description": "Slack channel ids routed to this repository."
        },
        "owner": {
          "type": "string",
          "pattern": "^[UW][A-Z0-9]{6,}$",
          "description": "Slack user id this runner belongs to."
        },
        "guests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[UW][A-Z0-9]{6,}$"
          },
          "description": "Extra Slack user ids this runner answers, typically teammates without their own agent plan."
        },
        "backend": {
          "enum": ["claude", "codex"],
          "default": "claude"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Model alias passed to the backend CLI."
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "description": "Git ref answered from, through a detached mirror worktree. Omit to answer from the working tree."
        },
        "maxQuestionsPerHour": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 20
        },
        "maxAnswerChars": {
          "type": "integer",
          "minimum": 200,
          "maximum": 8000,
          "default": 1500
        },
        "followThreads": {
          "type": "boolean",
          "default": true,
          "description": "Answer follow-ups in a thread the runner already replied in, without a new mention."
        },
        "onUnauthorized": {
          "enum": ["silent", "ephemeral"],
          "default": "ephemeral"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 900,
          "default": 240
        }
      }
    },
    "meetings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transcripts"],
      "description": "Meeting capture: where the kit files transcripts and notes produced from recordings. Machine-local settings (recordings folder, engine, model) live in .env.local.",
      "properties": {
        "inbox": {
          "type": "string",
          "minLength": 1,
          "description": "Workspace-relative folder on the shared drive where recorders drop finished recordings for a transcriber (team roles, phase 3)."
        },
        "transcripts": {
          "type": "string",
          "minLength": 1,
          "description": "Workspace-relative folder that receives one <date>-<slug>/ folder per transcribed recording; normally inside the docs Drive link."
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "description": "Workspace-relative folder for the meeting notes documents generated from transcripts."
        },
        "language": {
          "type": "string",
          "pattern": "^(auto|[a-z]{2,3}(-[A-Za-z]{2,4})?)$",
          "description": "Spoken language passed to the engine, or auto. Defaults to policies.conversationLanguage."
        },
        "naming": {
          "type": "string",
          "pattern": "\\{date\\}",
          "default": "{date}-{slug}",
          "description": "Transcript folder name template; {date}, {time}, and {slug} are replaced."
        },
        "memory": {
          "type": "boolean",
          "default": true,
          "description": "Log one project-memory entry (type meeting) per transcribed meeting when the memory section exists."
        },
        "knowledgeLog": {
          "type": "boolean",
          "default": false,
          "description": "Deprecated and ignored: meetings are logged to the memory section instead."
        },
        "recordings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keep"],
          "properties": {
            "keep": {
              "enum": ["local", "archive", "delete"],
              "default": "local",
              "description": "What happens to the original recording after a transcript exists."
            },
            "afterDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "description": "Required with keep = delete: days to wait after the transcript exists."
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Required with keep = archive: workspace-relative folder (normally on the shared drive) that receives the recordings."
            }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project"],
      "description": "Project and central knowledge memory: session summaries, decisions, findings, and meeting outcomes. See docs/memory-plan.md.",
      "properties": {
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "store": {
              "enum": ["journal", "sqlite-file"],
              "default": "journal",
              "description": "journal: one append-only JSONL file per author, safe with cloud sync clients. sqlite-file: a single shared file, only safe for a one-person project."
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Workspace-relative folder that holds the memory journals; should resolve through a drive.links entry so every teammate shares it."
            },
            "tags": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "description": "Suggested tags shown by the reviewed-logging skill; free text, not enforced."
            }
          }
        },
        "central": {
          "type": "object",
          "additionalProperties": false,
          "required": ["urlVariable"],
          "description": "Optional connection to a company-wide PostgreSQL database provisioned outside the kit.",
          "properties": {
            "urlVariable": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "description": "Name of the .env.local variable holding the personal connection string; never the value itself."
            },
            "schema": {
              "type": "string",
              "minLength": 1,
              "default": "nemeda_memory"
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "description": "Row id in the central projects table; defaults to project.id."
            },
            "promote": {
              "enum": ["reviewed", "all"],
              "default": "reviewed"
            }
          }
        },
        "harvest": {
          "type": "object",
          "additionalProperties": false,
          "description": "Unattended-capture tuning for `nemeda-agent memory harvest`. Harvesting itself is opt-in per machine (MEMORY_HARVEST=true in .env.local); this section only tunes it.",
          "properties": {
            "idleMinutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440,
              "default": 30,
              "description": "A session counts as closed once idle this long."
            },
            "maxSessionsPerRun": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 5,
              "description": "Upper bound on sessions resumed (and billed) per harvest run."
            },
            "hosts": {
              "type": "array",
              "items": { "enum": ["claude", "codex"] },
              "description": "Restrict harvesting to these hosts; defaults to both."
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "required": ["repository"]
    },
    {
      "required": ["workspace"]
    }
  ],
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "profiles"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workspaceRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "role", "profiles"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remote": {
          "type": "string",
          "minLength": 1,
          "description": "Git URL cloned by `nemeda-agent setup` when the path is missing."
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
