{
  "schemaVersion": 1,
  "project": {
    "id": "milence",
    "name": "Milence"
  },
  "workspace": {
    "repositories": [
      {
        "id": "milence-core",
        "path": "backend",
        "role": "backend-reference",
        "profiles": ["typescript", "nestjs"],
        "remote": "https://github.com/milence-it-eng/milence-core.git",
        "branch": "main"
      },
      {
        "id": "milence-mobile-app",
        "path": "mobile/react-native/react-native",
        "role": "mobile-react-native",
        "profiles": ["typescript", "expo", "react-native"]
      },
      {
        "id": "milence-ios",
        "path": "mobile/ios",
        "role": "mobile-native-ios",
        "profiles": ["swift", "swiftui"]
      }
    ]
  },
  "drive": {
    "sharedDrive": "Milence",
    "links": {
      "docs": "docs",
      "config": "config",
      ".claude/skills": "skills",
      ".claude/commands": "commands"
    }
  },
  "airtable": {
    "baseId": "appbuFqYt0o1E1Uhb",
    "tasks": {
      "tableId": "tblRw1YxcyRDKKhdf",
      "statusField": "Status",
      "notesField": "Notes",
      "statusInProgress": "In progress",
      "statusDone": "Completed"
    },
    "knowledgeLog": {
      "baseId": "appP3KJCLuNaQfrBH",
      "tableId": "tblgqAuwSqfsjM7Cq"
    },
    "reconcileRepos": ["milence-it-eng/milence-core"],
    "lookbackDays": 21
  },
  "context": {
    "instructions": ["AGENTS.md"],
    "documents": []
  },
  "tools": {
    "required": ["git", "github"],
    "optional": ["google-drive", "airtable", "figma", "apple-docs"]
  },
  "policies": {
    "protectSecrets": true,
    "conversationLanguage": "es",
    "artifactLanguage": "en"
  }
}
